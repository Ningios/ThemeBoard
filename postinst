#!/bin/sh
APP=/var/jb/Applications/ThemeBoard.app
chmod -R 755 "$APP" 2>/dev/null || true
chown -R mobile:mobile "$APP" 2>/dev/null || true

# ---- 0.15.74：预建主题根目录并交给 mobile ----
# App 运行在 mobile 下，无法在 <jbroot>/Library 里建目录（root:wheel 0755）。
# 安装时以 root 身份建好，并 chown 给 mobile，之后 App 就能自由读写/删除。
JBROOT=""
for d in /var/containers/Bundle/Application/.jbroot-*; do
  [ -d "$d" ] && JBROOT="$d" && break
done
[ -z "$JBROOT" ] && [ -d /var/jb ] && JBROOT="/var/jb"
if [ -n "$JBROOT" ]; then
  mkdir -p "$JBROOT/Library/ThemeBoard/Themes" "$JBROOT/Library/ThemeBoard/Assets" 2>/dev/null
  chown -R mobile:mobile "$JBROOT/Library/ThemeBoard" 2>/dev/null
  chmod -R 0755 "$JBROOT/Library/ThemeBoard" 2>/dev/null
  echo "[ThemeBoard] 主题根 = $JBROOT/Library/ThemeBoard"
fi
exit 0
